input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        scroll-method "two-finger"
    }

    mouse {
    }
}


output "eDP-1" {
    mode "1920x1080@144"

    scale 1

    position x=0 y=0
}

output "HDMI-A-1" {
    // mode "1920x1080@120"
    mode "1920x1080"

    scale 1

    // Transform allows to rotate the output counter-clockwise, valid values are:
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 and flipped-270.
    transform "normal"

    position x=0 y=-1080
}


