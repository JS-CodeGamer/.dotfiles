[alias]
  a       = add
  aa      = add .
  au      = add --update

  b       = branch
  bd      = branch --delete
  bi      = bisect start
  bb      = bisect bad
  bg      = bisect good

  c       = commit
  ca      = commit --all
  cam     = commit --amend --no-edit
  came    = commit --amend
  caam    = commit --amend --all

  co      = checkout

  d       = diff
  dn      = diff --name-only
  dt      = difftool

  f       = fetch
  l       = log --oneline --graph --decorate
  la      = log --oneline --graph --all --decorate
  ln      = l --name-only

  pu      = push
  pf      = push --force-with-lease
  p       = pull

  rs      = reset
  rso     = restore

  rb      = rebase -i
  rba     = rebase --abort
  rbc     = rebase --continue

  s       = status
  st      = stash
  sp      = stash pop

  sh      = show
  shn     = show --name-status

[user]
  email   = 85994817+JS-CodeGamer@users.noreply.github.com
  name    = Jagteshver Singh

[init]
  defaultBranch = main

[core]
  editor  = nvim
  autocrlf = input
  fsmonitor   = true
  untrackedCache = true

[pager]
  branch  = false
  diff    = delta
  log     = delta
  reflog  = delta
  show    = delta
  status = false

[interactive]
  diffFilter = delta --color-only

[delta]
  file-decoration-style = auto ul
  file-style = auto
  hunk-header-decoration-style = auto box
  hunk-header-line-number-style = auto
  line-numbers = true
  line-numbers-left-format = {nm:>3}│
  line-numbers-left-style = auto
  line-numbers-minus-style = auto
  line-numbers-plus-style = auto
  line-numbers-right-format = {np:>3}│
  line-numbers-right-style = auto
  line-numbers-zero-style = auto
  minus-emph-style = red bold
  minus-empty-line-marker-style = omit
  minus-style = red
  navigate = false
  plus-emph-style = green bold
  plus-empty-line-marker-style = omit
  plus-style = green
  side-by-side = false
  syntax-theme = base16-ocean.dark
  true-color = auto
  zero-style = auto

[diff]
  tool    = nvimdiff
  algorithm   = histogram
  colorMoved  = default
  colorMovedWS = ignore-all-space

[difftool]
  prompt  = true

[difftool "nvimdiff"]
  cmd     = "nvim -d \"$LOCAL\" \"$REMOTE\""

[merge]
  tool    = nvimdiff
  conflictstyle = zdiff3

[mergetool]
  prompt  = false
  keepBackup = false

[push]
  autoSetupRemote = true
  followTags = true

[rerere]
  enabled = true

[column]
  ui      = auto

[branch]
  sort    = -committerdate

[color]
  ui      = auto

[credential]
  helper = /usr/lib/git-core/git-credential-libsecret

[fetch]
  prune   = true
  writeCommitGraph = true


[pull]
  rebase  = true

[rebase]
  autoStash = true
  updateRefs  = true
  missingCommitsCheck = error

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[transfer]
  fsckObjects = true

[receive]
  fsckObjects = true

